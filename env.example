# TG_HOST: workspace endpoint from Savanna > workspace > Connect

TG_HOST=
TG_GRAPHNAME=OlympicGraphRAG
TG_CLOUD=true
TG_TOKEN=
TG_USE_CERT=true

# Keys for the runtime-selectable providers (Settings panel): Gemini, NVIDIA
# NIM, Groq. The chosen provider/model applies to all three pipelines.
# LLM_PROVIDER/LLM_MODEL below are the startup default.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# anthropic | google | openai | openai_compatible (groq, ollama, ...: set LLM_BASE_URL)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_SUPPORTS_TOOL_CALLING=auto
LLM_REPORTS_TOKEN_USAGE=auto
# Free tiers rate-limit; set 0 for a local server with no limit.
LLM_REQUESTS_PER_MINUTE=30
# Gemini thinking level: minimal | low | medium | high (empty = provider default)
LLM_THINKING=minimal

# Startup embedding model, by key: qwen3-embedding-0.6b | embeddinggemma-300m |
# gte-large-en-v1.5 | mxbai-embed-large-v1 | bge-large-en-v1.5. Switched at
# runtime from Settings (config-docs/EMBEDDING-SWITCHING.md). Served by
# Cloudflare Workers AI where it hosts the model (bge-large-en-v1.5), else
# local sentence-transformers.
# The Cloudflare token also serves the P3 reranker (@cf/baai/bge-reranker-base).
EMBEDDING_MODEL=bge-large-en-v1.5
# EMBEDDING_DIM is the model's own (768 for embeddinggemma-300m, else 1024).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional self-hosted embedding service, tried before Cloudflare and local:
# POST {url}/embed {"model": "<key>", "texts": [...]} -> {"embeddings": [...]}
EMBEDDING_HOST_URL=
# false skips the Cloudflare embedding tier (e.g. quota spent) / every remote tier.
EMBEDDING_CLOUDFLARE=true
EMBEDDING_REMOTE=true

RUN_K=10
RUN_CHUNK_TOKENS=300
RUN_CHUNK_OVERLAP=50
RUN_MAX_STEPS=6
RUN_MAX_TOKENS_PER_QUERY=20000
RUN_POOL_SIZE=2
RUN_LATENCY_MODE=throughput
RUN_MAX_TOTAL_TOKENS=5000000
RUN_SEED=

# Seconds /health/llm waits for its one-token completion (cold free-tier models are slow).
HEALTH_LLM_TIMEOUT_S=120

# Comma-separated browser origins allowed to call this API (CORS). The Vite
# dev server (5173) is included by default, so local `npm run dev` works
# against a locally running backend with no extra configuration.
OGR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
