# TG_HOST: workspace endpoint from Savanna > workspace > Connect

TG_HOST=
TG_GRAPHNAME=OlympicGraphRAG
TG_CLOUD=true
TG_TOKEN=
TG_USE_CERT=true

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_SUPPORTS_TOOL_CALLING=auto
LLM_REPORTS_TOKEN_USAGE=auto

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

RUN_K=10
RUN_CHUNK_TOKENS=300
RUN_CHUNK_OVERLAP=50
RUN_MAX_STEPS=6
RUN_MAX_TOKENS_PER_QUERY=20000
RUN_POOL_SIZE=2

OGR_API_KEY=
OGR_STREAM_TOKEN_TTL_S=300
