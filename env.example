# ─────────────────────────────────────────────────────────────
#  tigergraph-agentic-graph-rag — environment template
#  Copy to .env at the repo root.  .env is git-ignored.
#  No value in this file is a real credential.
# ─────────────────────────────────────────────────────────────

# ── TigerGraph (mandatory store for BOTH vectors and graph) ───
# Savanna: the workspace endpoint, NOT the organisation URL. Find it in the
# workspace's Connect / Access panel. It looks like
#   https://<workspace-id>.i.tgcloud.io
# Community Edition: http://localhost
TG_HOST=
TG_GRAPHNAME=OlympicGraphRAG

# Set true for a Savanna / TigerGraph Cloud workspace. This changes how the
# client builds URLs and negotiates TLS; leaving it false against a cloud
# workspace fails with a connection error, not an auth error.
TG_CLOUD=false

# Ports: leave BLANK for Savanna (TLS 443 is derived).
# Community Edition uses 14240 for both.
TG_RESTPP_PORT=
TG_GS_PORT=

# Supply exactly ONE of the four credential styles below. They are tried in
# this order, and the first non-empty one wins.
#
#   1. JWT bearer token (TigerGraph 4.x / Savanna)
TG_JWT_TOKEN=
#   2. A pre-minted REST++ token
TG_TOKEN=
#   3. A workspace secret, from which the client mints a token
TG_SECRET=
#   4. Basic credentials (Community Edition default)
TG_USERNAME=tigergraph
TG_PASSWORD=

TG_USE_CERT=true
TG_CERT_PATH=

# ── LLM: pluggable, local or cloud ────────────────────────────
# For an OpenAI / ChatGPT key:
#     LLM_PROVIDER=openai
#     LLM_MODEL=gpt-4o-mini          (cheap, and supports tool-calling, so the
#                                     intent parser takes the native path)
#     LLM_BASE_URL=                  (leave BLANK - the OpenAI default is used)
#     LLM_API_KEY=sk-...
#
# For a local Ollama server instead:
#     LLM_PROVIDER=openai_compatible
#     LLM_MODEL=qwen2.5:7b-instruct
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_API_KEY=                   (none needed)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
# auto | true | false - 'auto' probes at startup. Leave on auto: assuming
# capability is what breaks P3 silently on a local model.
LLM_SUPPORTS_TOOL_CALLING=auto
# auto | true | false - on 'auto', a figure counted with the model's own
# tokenizer is labelled local_tokenizer, and one with no tokenizer available
# is labelled estimated, so a guess is never reported as a count.
LLM_REPORTS_TOKEN_USAGE=auto
# Free tiers rate-limit hard; 6 is reasonable for a local server.
LLM_MAX_CONCURRENT=2
LLM_REQUESTS_PER_MINUTE=30

# ── Embeddings (local encoder; vectors are stored in TigerGraph) ──
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── This application's own API ────────────────────────────────
OGR_API_KEY=
OGR_HOST=127.0.0.1
OGR_PORT=8000
OGR_STREAM_TOKEN_TTL_S=300

# ── Run defaults (overridable per run; written into every run header) ──
RUN_K=10
RUN_CHUNK_TOKENS=300
RUN_CHUNK_OVERLAP=50
RUN_MAX_STEPS=6
RUN_MAX_TOKENS_PER_QUERY=20000
RUN_MAX_TOTAL_TOKENS=5000000
RUN_LATENCY_MODE=throughput
RUN_PARSE_CONFIDENCE_THRESHOLD=0.9

# ── Frontend (build-time, shipped to the browser) ─────────────
# VITE_API_KEY is NOT a secret. It guards against casual access on a shared
# network. Never reuse it anywhere that matters.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_KEY=
