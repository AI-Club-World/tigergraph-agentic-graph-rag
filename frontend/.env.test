# Loaded by Vite/Vitest for `npm test` (mode "test") instead of `.env`, so
# the suite always exercises the fixture-backed mock transport regardless of
# whatever `.env` is configured for local `npm run dev` against a real
# backend. Without this file, flipping `.env`'s VITE_USE_MOCK_API to false
# makes every component test that expects fixture data fail.
VITE_USE_MOCK_API=true
VITE_MOCK_LATENCY_SCALE=0
