# ── Frontend (build-time) ─────────────────────────────────────
# Read by frontend/src/config.ts. Vite exposes only VITE_-prefixed variables
# and reads this file at startup/build: restart `npm run dev` after a change.
# Every value here ends up in the public JS bundle — never put a secret here.

VITE_API_BASE_URL=http://127.0.0.1:8000

# There is no API key: the application is open. A VITE_API_KEY is refused at
# build time, because every VITE_ value is public.

# ── Mock / real API switch ────────────────────────────────────
# Off by default: only the exact value `true` serves every screen from
# src/fixtures/ (with a "mock data" chip). Anything else — unset, empty,
# `false`, a typo — uses the live backend.
VITE_USE_MOCK_API=false

# Multiplier on the mock transport's replay delays. 1 = realistic pacing,
# 0 = instant (tests, screenshots). Ignored when mocks are off.
VITE_MOCK_LATENCY_SCALE=1

# Run shown by the Dashboard and Eval table tabs when the URL has no ?run=.
# `latest` (or unset): against the live backend, opens the newest run from
# GET /runs; in mock mode, the fixture run named "latest". Any other value is
# loaded as that run id.
VITE_DEFAULT_RUN_ID=latest

# ── Service availability ──────────────────────────────────────
# Address used in mailto: links when TigerGraph, the LLM or the embedding
# backend is offline. Replace the placeholder.
VITE_ADMIN_EMAIL=admin@example.com

# Health-check polling interval in ms (default 600000 = 10 min). A failed API
# call also triggers an immediate re-check.
VITE_POLL_INTERVAL_MS=600000

# Browser time limit for /health/llm in ms. Keep it above the backend's
# HEALTH_LLM_TIMEOUT_S (120 s by default).
VITE_LLM_HEALTH_TIMEOUT_MS=130000
