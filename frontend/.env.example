# ── Frontend (build-time) ─────────────────────────────────────
# TECHNICAL-SPEC §14.2. Vite only exposes variables prefixed VITE_.

VITE_API_BASE_URL=http://127.0.0.1:8000

# X-API-Key sent on every request except /health (TECHNICAL-SPEC §4.5).
# Shipped to the browser and therefore NOT a secret — it protects against
# casual access on a shared network. Do not reuse it anywhere that matters.
VITE_API_KEY=

# ── Mock / real API switch ────────────────────────────────────
# The single switch between the fixture-backed mock transport and the real
# backend. `true` (default) serves every screen from src/fixtures/*.json so the
# UI runs with no backend. Set to `false` once the FastAPI service is up.
VITE_USE_MOCK_API=true

# Multiplier on the mock transport's replay delays. 1 = realistic pacing,
# 0 = instant (useful for tests and screenshots). Ignored when mocks are off.
VITE_MOCK_LATENCY_SCALE=1

# Default batch run id read by the dashboard and eval table when the URL
# carries no ?run= parameter.
VITE_DEFAULT_RUN_ID=latest
