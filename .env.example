# Environment for the TigerGraph Agentic GraphRAG system (Round 1 + Round 2).
#
# Set these as environment variables (e.g. in your cloud environment's
# secrets), or copy this file to `.env` and fill it in. `.env` is gitignored;
# never commit real values. Values in <angle brackets> are placeholders you
# must replace; other values are working defaults.

# ---- TigerGraph (required: build.sh and run.sh) ----------------------------
TG_HOST=<https://your-workspace.i.tgcloud.io>
TG_GRAPHNAME=OlympicGraphRAG
TG_CLOUD=true
TG_USE_CERT=true
# Credentials: set ONE of the following styles (checked in this order); leave the others empty.
TG_JWT_TOKEN=
TG_TOKEN=
TG_SECRET=
TG_USERNAME=
TG_PASSWORD=

# ---- LLM (required: run.sh; not needed by build.sh) ------------------------
# Provider: openai_compatible (any OpenAI-style endpoint), gemini, nvidia_nim,
# groq, or anthropic. One model serves every call in a run.
LLM_PROVIDER=openai_compatible
LLM_MODEL=<your-model-name>
# OpenAI-compatible base URL (leave empty for gemini / anthropic).
LLM_BASE_URL=<https://your-llm-host/v1>
LLM_API_KEY=<llm-api-key>
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_SUPPORTS_TOOL_CALLING=auto
LLM_REPORTS_TOKEN_USAGE=auto
LLM_THINKING=

# Optional: keys for the providers selectable at runtime in the web UI.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# ---- Embeddings (Round 1 RAG pipeline and web UI only; Round 2 needs none) --
# Optional self-hosted embedding service: POST {url}/embed. Empty = local model.
EMBEDDING_HOST_URL=
EMBEDDING_MODEL=bge-large-en-v1.5
EMBEDDING_DIM=1024
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Round 1 run parameters ---------------------------------------------------
RUN_K=10
RUN_CHUNK_TOKENS=300
RUN_CHUNK_OVERLAP=50
RUN_MAX_STEPS=6
RUN_MAX_TOKENS_PER_QUERY=20000
RUN_POOL_SIZE=2
OGR_API_KEY=

# ---- Round 2 -------------------------------------------------------------------
# Maximum agent tool calls per question.
R2_MAX_STEPS=8
# LLM price in USD per 1M tokens, for cost_usd_total in metrics.json (0 = cost not tracked).
R2_LLM_INPUT_USD_PER_M=0
R2_LLM_OUTPUT_USD_PER_M=0
# Append-only JSONL log of every TigerGraph call (submission item).
R2_QUERY_LOG=out/r2/tg_query_log.jsonl
# Optional: "text" = prompt-based JSON tool calls for models without native tool calling (default: native).
# R2_TOOL_MODE=
