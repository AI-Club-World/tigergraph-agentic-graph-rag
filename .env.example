# Copy this file to .env and fill in the secrets. .env.example is the canonical key list
# (env.example is the older copy kept for the Round 1 workflow).

TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=OlympicGraphRAG
TG_CLOUD=true
TG_TOKEN=
TG_USE_CERT=true
TG_USERNAME=ogr_app
TG_PASSWORD=
 
LLM_PROVIDER=openai_compatible

 
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
 
# Runtime-selectable provider keys (Settings panel → provider dropdown)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
 
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_SUPPORTS_TOOL_CALLING=auto
LLM_REPORTS_TOKEN_USAGE=auto
LLM_THINKING=
 
# Embedding configuration
EMBEDDING_HOST_URL=
EMBEDDING_MODEL=bge-large-en-v1.5
EMBEDDING_DIM=1024
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
 
RUN_K=10
RUN_CHUNK_TOKENS=300
RUN_CHUNK_OVERLAP=50
RUN_MAX_STEPS=6
RUN_MAX_TOKENS_PER_QUERY=20000
RUN_POOL_SIZE=2
 
OGR_API_KEY=

# ---- Round 2 ----
# Maximum agent steps (tool calls) per question.
R2_MAX_STEPS=8
# LLM price in USD per 1M input tokens, used for cost_usd_total in metrics.json (0 = cost not tracked).
R2_LLM_INPUT_USD_PER_M=0
# LLM price in USD per 1M output tokens, used for cost_usd_total in metrics.json.
R2_LLM_OUTPUT_USD_PER_M=0
# Append-only JSONL log of every TigerGraph call (submission item 5).
R2_QUERY_LOG=out/r2/tg_query_log.jsonl
